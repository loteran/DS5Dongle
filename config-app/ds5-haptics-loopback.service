[Unit]
Description=DS5Dongle auto-haptics audio loopback (active only while the dongle is present)
Documentation=https://github.com/loteran/DS5Dongle
After=pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service
# This unit is started on demand by udev (ENV{SYSTEMD_USER_WANTS}) when the
# DualSense dongle is plugged in, and stopped by udev when it is unplugged.
# It is ALSO enabled at boot (see [Install]) to cover the cold-plug case: when
# the dongle is already connected at boot, udev's ADD event does not fire, so
# without this the service would never start and haptics stay dead until a
# manual replug. Enabling it is safe because the ExecStartPre guard below
# refuses to start (exit 1) when ds5_dongle_sink is absent — so a missing
# dongle can never make the playback fall back to the speakers / feedback.
# Bound automatic restarts so a permanently broken state can't spin forever.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# Safety guard + boot/plug race handling: wait (up to ~15s) for the dongle sink
# (ds5_dongle_sink, renamed by 51-ds5dongle.conf) to actually appear before
# launching the loopback. At boot or plug-in, udev may start us before
# WirePlumber has applied the rename; testing only once and giving up left
# pw-loopback to exit immediately and haptics dead until the next manual plug.
# If the sink never shows up (dongle truly absent) the guard fails and the
# service does not start — no feedback loop.
#
# Force the DualSense card onto its pro-audio profile FIRST: without it the 4ch
# ds5_dongle_sink never exists and the guard below would spin until the start
# limit (the pad often boots / wakes on the "off" profile). Best-effort ('-'),
# dynamic card lookup so it works whatever the pad's card name is.
ExecStartPre=-/bin/sh -c 'c=$$(pactl list cards short | awk "tolower(\\$$0) ~ /dualsense/ {print \\$$2; exit}"); [ -n "$$c" ] && pactl set-card-profile "$$c" pro-audio'
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do pactl list short sinks | grep -q "\\bds5_dongle_sink\\b" && exit 0; sleep 0.5; done; exit 1'
# Two passive loopbacks feed the dongle's AUX2/AUX3, both following ASM's Sonar
# channels so only the wanted audio triggers haptics.
# The 4ch pro-audio sink maps aux0/aux1 to the pad's 3.5mm headphone jack and
# aux2/aux3 to the left/right haptic actuators: feeding aux0/aux1 plays the
# audio into the jack and never vibrates, which looks identical to a healthy
# setup (profile, sink and links all fine) — hence AUX2/AUX3 here.
# Which sinks get captured is decided by /usr/lib/ds5dongle/ds5-haptics-sources
# (shared with the watchdog, see that script for the rules — in short: everything
# vibrates except ASM's Chat and Media channels, and it works with no ASM at all).
# It is given 15s to wait for ASM's sinks, which come up after this service at
# boot/cold-plug; deciding too early made the capture fall back to the full
# Game+Chat+Media mix and the pad vibrated on chat audio.
#
# The previous version hardcoded the ASM "output" channel as
# effect_input.sonar-output-eq and gated it on `pactl list short sinks`. That node
# is media.class=Audio/Sink/Internal, so it never appears in that list: the gate
# could not ever pass and the second loopback never started — audio sent to the
# TV never produced any vibration.
#
# Each loopback activates only when its sink plays audio. node.dont-reconnect=true
# on each playback side ensures no fallback to speakers if the dongle disappears
# at runtime. ($$ is systemd's escape for a literal $ passed to the shell.)
ExecStart=/bin/sh -c '\
  eval "$$(/usr/lib/ds5dongle/ds5-haptics-sources 15)"; \
  if [ -z "$$GAME_SRC" ] && [ -z "$$OUT_SRC" ]; then \
    echo "no safe capture source (default sink is the dongle itself?) — not starting"; \
    exit 1; \
  fi; \
  if [ -n "$$GAME_SRC" ]; then \
    /usr/bin/pw-loopback -c 2 \
      --capture-props="node.name=ds5_haptics_capture_game media.class=Stream/Input/Audio stream.capture.sink=true target.object=$$GAME_SRC audio.position=[FL,FR] stream.dont-remix=true node.passive=true" \
      --playback=ds5_dongle_sink \
      --playback-props="node.name=ds5_haptics_playback_game node.dont-reconnect=true audio.position=[AUX2,AUX3] stream.dont-remix=true node.passive=true" \
    & \
  fi; \
  if [ -n "$$OUT_SRC" ]; then \
    /usr/bin/pw-loopback -c 2 \
      --capture-props="node.name=ds5_haptics_capture_output media.class=Stream/Input/Audio stream.capture.sink=true target.object=$$OUT_SRC audio.position=[FL,FR] stream.dont-remix=true node.passive=true" \
      --playback=ds5_dongle_sink \
      --playback-props="node.name=ds5_haptics_playback_output node.dont-reconnect=true audio.position=[AUX2,AUX3] stream.dont-remix=true node.passive=true" \
    & \
  fi; \
  wait'
# Restart on any unexpected exit (pw-loopback should run as long as the dongle
# is present). systemd does NOT restart after a commanded stop, so the udev
# unplug handler still stops it cleanly with no feedback risk.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
