[Unit]
Description=DS5Dongle auto-haptics audio loopback (active only while the dongle is present)
Documentation=https://github.com/loteran/DS5Dongle
After=pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service
# This unit is started on demand by udev (ENV{SYSTEMD_USER_WANTS}) when the
# DualSense dongle is plugged in, and stopped by udev when it is unplugged.
# It is ALSO enabled at boot (see [Install]) to cover the cold-plug case: when
# the dongle is already connected at boot, udev's ADD event does not fire, so
# without this the service would never start and haptics stay dead until a
# manual replug. Enabling it is safe because the ExecStartPre guard below
# refuses to start (exit 1) when ds5_dongle_sink is absent — so a missing
# dongle can never make the playback fall back to the speakers / feedback.
# Bound automatic restarts so a permanently broken state can't spin forever.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# Safety guard + boot/plug race handling: wait (up to ~15s) for the dongle sink
# (ds5_dongle_sink, renamed by 51-ds5dongle.conf) to actually appear before
# launching the loopback. At boot or plug-in, udev may start us before
# WirePlumber has applied the rename; testing only once and giving up left
# pw-loopback to exit immediately and haptics dead until the next manual plug.
# If the sink never shows up (dongle truly absent) the guard fails and the
# service does not start — no feedback loop.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do pactl list short sinks | grep -q "\\bds5_dongle_sink\\b" && exit 0; sleep 0.5; done; exit 1'
# Two passive loopbacks: one from the Arctis headset (ASM sonar chain), one
# from HDMI. Each activates only when its sink plays audio; PipeWire mixes
# both into the dongle's AUX0/AUX1. node.dont-reconnect=true on each playback
# side ensures no fallback to speakers if the dongle disappears at runtime.
ExecStart=/bin/sh -c '\
  /usr/bin/pw-loopback -c 2 \
    --capture-props="node.name=ds5_haptics_capture_arctis media.class=Stream/Input/Audio stream.capture.sink=true target.object=alsa_output.usb-SteelSeries_Arctis_Nova_Pro_Wireless-00.analog-stereo audio.position=[FL,FR] stream.dont-remix=true node.passive=true" \
    --playback=ds5_dongle_sink \
    --playback-props="node.name=ds5_haptics_playback_arctis node.dont-reconnect=true audio.position=[AUX0,AUX1] stream.dont-remix=true node.passive=true" \
  & \
  /usr/bin/pw-loopback -c 2 \
    --capture-props="node.name=ds5_haptics_capture_hdmi media.class=Stream/Input/Audio stream.capture.sink=true target.object=alsa_output.pci-0000_09_00.1.hdmi-surround audio.position=[FL,FR] stream.dont-remix=true node.passive=true" \
    --playback=ds5_dongle_sink \
    --playback-props="node.name=ds5_haptics_playback_hdmi node.dont-reconnect=true audio.position=[AUX0,AUX1] stream.dont-remix=true node.passive=true" \
  & \
  wait'
# Restart on any unexpected exit (pw-loopback should run as long as the dongle
# is present). systemd does NOT restart after a commanded stop, so the udev
# unplug handler still stops it cleanly with no feedback risk.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
